# Safe defaults: simulations only, loopback only.
WINCH_PORT=4321
WINCH_HOST=127.0.0.1
WINCH_LIVE_HARNESSES=0
WINCH_CODEX_ENABLED=0
WINCH_ACTIONS_ENABLED=0
WINCH_HARNESS_CONFIG=./config/harnesses.json
WINCH_ACTION_CONFIG=./config/action-grants.json
WINCH_RETENTION_DAYS=30
# Optional authenticated loopback bridge for C-Plug. Use the same randomly
# generated value for CPLUG_WINCH_TOKEN. Minimum 32 characters.
WINCH_BRIDGE_TOKEN=
